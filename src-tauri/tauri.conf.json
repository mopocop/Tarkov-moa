{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tarkov Companion",
  "version": "0.8.0",
  "identifier": "com.tarkov-companion.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tarkov MoA",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/mopocop/Tarkov-moa/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyOTg4RDk0RUVFNjVEMUYKUldRZlhlYnVsSTJZOHZ5ejhNL0JEZXhuZVp6VWcyZFVIWnBwdDFVUWd2WmU3MWRmYi9LLzljTjIK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "Moacir",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}