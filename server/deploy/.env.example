# Copy to .env (gitignored) on the server and fill in.

# Tailscale auth key for the dedicated relay node.
# Generate in the admin console → Settings → Keys → Generate auth key:
#   - Reusable: ON   (redeploys reuse it)
#   - Ephemeral: ON  (node self-removes if the container is destroyed)
#   - Tags: tag:relay
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxx

# Strong random token gating GET /stats. Generate with: openssl rand -hex 24
# Leave EMPTY to disable /stats entirely (it returns 404). Recommended empty
# unless you actively want to poll relay metrics.
STATS_TOKEN=
